function grp(s){return s.replace(/\B(?=(\d{3})+(?!\d))/g,'.')}
/** nilai kanonik ("17850.5") atau angka -> tampilan "17.850,5" */
function toDisp(c){
  if(c===null||c===undefined||c==='')return '';
  if(typeof c==='number'){if(!isFinite(c))return '';c=/e/i.test(String(c))?c.toFixed(10).replace(/0+$/,'').replace(/\.$/,''):String(c)}
  c=String(c).trim();var neg=c.charAt(0)==='-',p=c.replace('-','').split('.');
  return (neg?'-':'')+grp(p[0]||'0')+(p.length>1&&p[1]!==''?','+p[1]:'')}
/** tampilan terformat -> kanonik ("17.850,5" -> "17850.5") */
function fromDisp(s){s=String(s==null?'':s).trim();return s===''?'':s.replace(/\./g,'').replace(',','.')}
/** teks mentah + posisi kursor -> {disp,pos}. Aturan Indonesia: koma = desimal; titik = pemisah ribuan (dibuat otomatis, titik yang diketik diabaikan) */
function typedNorm(raw,caret,isDel){
  var typed=isDel?'':raw.charAt(caret-1),intp='',fra='',dec=false,ci;
  if(typed===','){
    var rest=raw.slice(0,caret-1)+raw.slice(caret);
    if(rest.indexOf(',')<0){intp=raw.slice(0,caret-1).replace(/\D/g,'');fra=raw.slice(caret).replace(/\D/g,'');dec=true}
  }
  if(!dec){ci=raw.indexOf(',');
    if(ci>=0){intp=raw.slice(0,ci).replace(/\D/g,'');fra=raw.slice(ci+1).replace(/\D/g,'');dec=true}
    else intp=raw.replace(/\D/g,'')}
  intp=intp.replace(/^0+(?=\d)/,'');fra=fra.slice(0,10);
  var disp=dec?grp(intp||'0')+','+fra:(intp===''?'':grp(intp));
  var sig=(raw.slice(caret).replace(/[^\d,]/g,'')).length,i=disp.length,c=0;
  while(i>0&&c<sig){i--;if(disp.charAt(i)!=='.')c++}
  return {disp:disp,pos:i}}
/** teks tempelan -> kanonik. "17.850,5"->17850.5, "50.1084"->50.1084, "1.234.567"->1234567 */
function pasteCanon(t){
  t=String(t).replace(/[^\d.,]/g,'');var d=t.lastIndexOf('.'),k=t.lastIndexOf(',');
  if(d>=0&&k>=0){var m=Math.max(d,k);return t.slice(0,m).replace(/[.,]/g,'')+'.'+t.slice(m+1).replace(/[.,]/g,'')}
  if(k>=0)return t.replace(/\./g,'').replace(',','.');
  if(d>=0){if(/^\d{1,3}(\.\d{3})+$/.test(t))return t.replace(/\./g,'');var ps=t.split('.'),l=ps.pop();return ps.join('')+'.'+l}
  return t}
function setNum(el,val){if(!el)return;el.value=toDisp(val);el.dataset.pv=el.value}
function onNumInput(ev){
  var el=ev.target;if(!el||!el.dataset||el.dataset.num!=='1')return;
  var raw=el.value,caret=(el.selectionStart==null)?raw.length:el.selectionStart,it=ev.inputType||'',del=it.indexOf('delete')===0;
  if(del){var pv=el.dataset.pv||'';if(raw.length===pv.length-1&&pv.charAt(caret)==='.'){ /* hapus titik ribuan = hapus digit di sebelahnya */
    if(it==='deleteContentForward')raw=raw.slice(0,caret)+raw.slice(caret+1);else{raw=raw.slice(0,caret-1)+raw.slice(caret);caret--}}}
  var r=typedNorm(raw,caret,del);el.value=r.disp;el.dataset.pv=r.disp;
