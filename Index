<!DOCTYPE html>
<html lang="id">
<head>
<base target="_top">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B1020">
<title>Trading Tracker</title>
<style>
:root{--bg:#0B1020;--card:#151B2E;--card2:#1C2440;--line:#26304F;--tx:#F1F5FF;--mut:#8D9ABF;--acc:#7C6CFF;--acc2:#38BDF8;--ok:#22D3A0;--bad:#FF6B81;--warn:#FBBF24;--fs:16px;--out:#05070F}
:root[data-t=light]{--bg:#F1F4FC;--card:#FFFFFF;--card2:#EEF1FB;--line:#DDE3F3;--tx:#141A33;--mut:#6B7697;--out:#D5DCEF}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--out);color:var(--tx);font-family:system-ui,-apple-system,Roboto,Arial,sans-serif;font-size:var(--fs);overscroll-behavior:none}
#app{position:fixed;left:50%;transform:translateX(-50%);top:0;width:100%;max-width:480px;background:var(--bg);box-shadow:0 0 0 1px var(--line),0 0 60px rgba(0,0,0,.35);height:var(--vh,100%);display:flex;flex-direction:column;overflow:hidden}
header{flex:none;display:flex;align-items:center;justify-content:space-between;padding:calc(env(safe-area-inset-top,0px) + 12px) 18px 10px}
header small{color:var(--mut);font-size:.8em;display:block}header b{font-size:1.25em}
.av{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--acc),var(--acc2));display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;overflow:hidden;border:2px solid var(--card2);flex:none}
.av img{width:100%;height:100%;object-fit:cover}
main{flex:1;overflow-y:auto;overflow-x:hidden;padding:4px 16px 120px;-webkit-overflow-scrolling:touch}
.pg{display:none}.pg.on{display:block}
.card{background:var(--card);border-radius:22px;padding:18px;margin-bottom:16px;border:1px solid var(--line);overflow:hidden}
.hero{background:linear-gradient(135deg,#6D5BFF,#38BDF8);color:#fff;border:0;box-shadow:0 12px 30px rgba(109,91,255,.35)}
.hero small{opacity:.85}.hero .big{font-size:2em;font-weight:800;margin:4px 0 10px;word-break:break-word}
.pill{display:inline-block;padding:5px 12px;border-radius:99px;font-size:.8em;font-weight:700;background:rgba(255,255,255,.22)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:14px;min-width:0}
.kpi .ic{width:36px;height:36px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:10px}
.kpi small{color:var(--mut);font-size:.8em;display:block}.kpi b{font-size:1.1em;word-break:break-word}
h2{font-size:1.1em;margin:22px 4px 12px}
.ch{display:flex;align-items:center;gap:10px;margin-bottom:12px;font-weight:700}
.ch .ic{width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-top:1px solid var(--line)}
.row:first-of-type{border-top:0}.row>span:first-child{min-width:0}.row>span:last-child{text-align:right;font-weight:700;flex:none;max-width:55%;word-break:break-word}
.row small{display:block;color:var(--mut);font-size:.78em;font-weight:400}
.pos{color:var(--ok)}.neg{color:var(--bad)}
.bar{height:12px;background:var(--card2);border-radius:99px;overflow:hidden;margin:10px 0 6px}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--acc),var(--ok));border-radius:99px}
.cap{font-size:.8em;color:var(--mut);margin-top:6px;min-height:18px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.chip{padding:10px 16px;border-radius:99px;border:1px solid var(--line);background:var(--card);color:var(--mut);font-size:.9em;font-weight:700}
.chip.on{background:var(--acc);border-color:var(--acc);color:#fff}
.hi{display:flex;align-items:center;gap:12px;padding:14px;background:var(--card);border:1px solid var(--line);border-radius:18px;margin-bottom:10px;width:100%;text-align:left;color:var(--tx);font:inherit}
.hi .ic{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex:none}
.hi .m{flex:1;min-width:0}.hi .m b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hi small{color:var(--mut);font-size:.8em}
.hi .v{text-align:right;font-weight:700;flex:none}
.fab{position:fixed;right:18px;bottom:calc(env(safe-area-inset-bottom,0px) + 86px);z-index:20;width:62px;height:62px;border-radius:50%;border:0;background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;box-shadow:0 10px 26px rgba(124,108,255,.55);display:flex;align-items:center;justify-content:center}
nav{flex:none;display:flex;background:var(--card);border-top:1px solid var(--line);padding:8px 8px calc(env(safe-area-inset-bottom,0px) + 8px)}
nav button{flex:1;border:0;background:transparent;color:var(--mut);display:flex;flex-direction:column;align-items:center;gap:4px;font-size:.78em;font-weight:700;padding:6px 0;border-radius:14px}
nav button.on{color:var(--acc)}nav button.on svg{transform:translateY(-1px)}
.ov{position:fixed;left:50%;transform:translateX(-50%);top:0;width:100%;max-width:480px;height:var(--vh,100%);background:var(--bg);z-index:40;display:none;flex-direction:column}.ov.on{display:flex}
.ov .hd{display:flex;align-items:center;gap:12px;padding:calc(env(safe-area-inset-top,0px) + 12px) 16px 10px;font-weight:800;font-size:1.15em}
.ov .bd{flex:1;overflow-y:auto;padding:4px 16px 40px}
.ib{width:42px;height:42px;border-radius:14px;border:1px solid var(--line);background:var(--card);color:var(--tx);display:flex;align-items:center;justify-content:center;flex:none}
label{display:block;font-size:.85em;color:var(--mut);margin:14px 2px 6px;font-weight:600}
input,select{width:100%;padding:15px;font-size:1.05em;border-radius:14px;border:1px solid var(--line);background:var(--card);color:var(--tx);font-family:inherit;min-height:52px}
input:focus,select:focus{outline:2px solid var(--acc);border-color:transparent}
.pv{margin-top:16px;padding:14px;border-radius:16px;background:var(--card2);color:var(--mut);font-size:.95em}
.btn{width:100%;margin-top:16px;padding:16px;border:0;border-radius:16px;background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;font-size:1.05em;font-weight:800;font-family:inherit}
.btn.g{background:var(--card2);color:var(--tx);border:1px solid var(--line)}.btn.r{background:var(--bad)}.btn:disabled{opacity:.5}
.msg{margin-top:12px;text-align:center;font-size:.95em}
.sheet{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:100%;max-width:480px;z-index:50;background:var(--card);border-radius:26px 26px 0 0;padding:22px 18px calc(env(safe-area-inset-bottom,0px) + 22px);display:none;max-height:85%;overflow-y:auto;box-shadow:0 -10px 40px rgba(0,0,0,.4)}
.sheet.on{display:block}.scrim{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:45;display:none}.scrim.on{display:block}
.dlg{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:88%;max-width:380px;z-index:60;background:var(--card);border-radius:24px;padding:24px;display:none;text-align:center}.dlg.on{display:block}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tg{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-top:1px solid var(--line)}
.dn{display:flex;align-items:center;gap:14px}.leg{font-size:.9em;line-height:1.8}.leg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px}
.hb{display:flex;align-items:center;gap:8px;margin:10px 0;font-size:.85em}.hl{width:96px;flex:none;color:var(--mut)}.ht{flex:1;height:10px;background:var(--card2);border-radius:99px;overflow:hidden}.ht i{display:block;height:100%}.hv{width:76px;flex:none;text-align:right}
.ax{fill:var(--mut);font-size:9px}.gl{stroke:var(--line);stroke-width:.6}
.toast{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 160px);transform:translateX(-50%);background:var(--tx);color:var(--bg);padding:12px 18px;border-radius:99px;font-weight:700;z-index:70;display:none;font-size:.9em;max-width:90%}
details>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px}details>summary::-webkit-details-marker{display:none}details[open]>summary{margin-bottom:6px!important}.pc{color:var(--acc);font-weight:700;margin-top:4px}
/* [S1] sembunyikan scrollbar tebal di PC (scroll tetap jalan) */
html,main,.ov .bd,.sheet{scrollbar-width:none}main::-webkit-scrollbar,.ov .bd::-webkit-scrollbar,.sheet::-webkit-scrollbar{display:none}
.mg{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.mg>div{background:var(--card2);border-radius:14px;padding:10px 12px;min-width:0}.mg small{display:block;color:var(--mut);font-size:.72em;line-height:1.3}.mg b{display:block;font-size:1.05em;margin:2px 0 1px;word-break:break-word}.mg small.pos{color:var(--ok)}.mg small.neg{color:var(--bad)}
.ns{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:14px;background:var(--card2)}.ns .nt{flex:1;min-width:0}.ns .nt b{display:block;font-size:.88em}.ns .nt small{display:block;color:var(--mut);font-size:.72em;margin-top:1px}
.dot{width:9px;height:9px;border-radius:50%;background:var(--mut);flex:none}.dot.on{background:var(--ok);box-shadow:0 0 0 3px rgba(34,211,160,.18)}
.pb{border:1px solid var(--line);background:var(--card);color:var(--tx);border-radius:99px;padding:7px 14px;font-size:.78em;font-weight:700;font-family:inherit;flex:none;display:inline-flex;align-items:center;gap:6px}.pb.pri{background:var(--acc);border-color:var(--acc);color:#fff}.pb.ic{padding:7px 9px}
.btn.m{padding:11px;font-size:.92em;border-radius:14px;margin-top:10px}
button.kpi{font:inherit;color:var(--tx);text-align:left;width:100%;cursor:pointer;position:relative;display:block}button.kpi:active{transform:scale(.98)}.kpi .go{position:absolute;right:12px;top:12px;opacity:.45;display:flex}
.fcard{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:14px 6px 10px;display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-bottom:16px}
.ft{background:transparent;border:0;display:flex;flex-direction:column;align-items:center;gap:8px;font:inherit;color:var(--tx);padding:4px 2px;cursor:pointer}.ft:active{transform:scale(.95)}
.ft .fi{position:relative;width:50px;height:50px;border-radius:16px;display:flex;align-items:center;justify-content:center}
.ft em{position:absolute;top:-6px;right:-12px;background:var(--acc);color:#fff;font-style:normal;font-size:.6em;font-weight:800;padding:2px 6px;border-radius:99px}
.ft small{font-size:.76em;line-height:1.25;color:var(--mut);font-weight:600}
.hero .frb{height:8px;background:rgba(255,255,255,.28);border-radius:99px;overflow:hidden;margin:12px 0 5px}.hero .frb i{display:block;height:100%;background:#fff;border-radius:99px}
</style>
</head>
<body>
<div id="app">
  <header>
    <div><small id="hi">Selamat datang</small><b id="hn">Trading Tracker</b></div>
    <button class="av" id="avBtn" style="border:2px solid var(--card2);padding:0"></button>
  </header>
  <main id="main">
    <section class="pg on" id="p_dash">Memuat...</section>
    <section class="pg" id="p_sum"></section>
    <section class="pg" id="p_his"></section>
  </main>
  <nav id="nav">
    <button data-p="dash" class="on"></button><button data-p="sum"></button><button data-p="his"></button>
  </nav>
  <button class="fab" id="fab" aria-label="Tambah input"></button>
</div>

<!-- input / edit -->
<div class="ov" id="ovIn">
  <div class="hd"><button class="ib" id="inBack"></button><span id="inTitle">Input baru</span></div>
  <div class="bd">
    <div class="chips" id="tabs"></div>
    <div class="cap" style="margin:-6px 2px 2px">Aturan Indonesia: titik ribuan muncul otomatis (1.000.000), gunakan koma untuk desimal (60,5353).</div>
    <label>Tanggal</label><input type="date" id="tanggal">
    <div id="fields"></div>
    <label>Catatan (opsional)</label><input type="text" id="catatan">
    <div class="pv" id="pv"></div>
    <button class="btn" id="go">Simpan</button>
    <div class="msg" id="msg"></div>
  </div>
</div>

<!-- fitur tambahan -->
<div class="ov" id="ovFt">
  <div class="hd"><button class="ib" id="ftBack"></button><span id="ftTitle">Fitur</span></div>
  <div class="bd" id="ftBody"></div>
</div>

<!-- notifikasi -->
<div class="ov" id="ovNf">
  <div class="hd"><button class="ib" id="nfBack"></button><span>Pengaturan notifikasi</span></div>
  <div class="bd" id="nfBody"></div>
</div>

<!-- profil -->
<div class="ov" id="ovPf">
  <div class="hd"><button class="ib" id="pfBack"></button><span>Profil &amp; Pengaturan</span></div>
  <div class="bd" id="pfBody"></div>
</div>

<div class="scrim" id="scrim"></div>
<div class="sheet" id="sheet"></div>
<div class="dlg" id="dlg"></div>
<div class="toast" id="toast"></div>

<script>
var $=function(i){return document.getElementById(i)};
var IC={
home:'<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
chart:'<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>',
list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
plus:'<path d="M12 5v14M5 12h14"/>',back:'<path d="M15 18l-6-6 6-6"/>',
edit:'<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
trash:'<path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/>',
up:'<path d="M12 19V5M5 12l7-7 7 7"/>',down:'<path d="M12 5v14M19 12l-7 7-7-7"/>',
wallet:'<path d="M3 7h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 7l12-3v3M17 14h.01"/>',
coin:'<circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 10h5a2 2 0 0 1 0 4H9"/>',
gift:'<path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7S9 7 8 5s1-3 4 2c3-5 5-4 4-2s-4 2-4 2"/>',
trend:'<path d="M3 17l6-6 4 4 8-8M15 7h6v6"/>',
fee:'<path d="M12 2v20M17 6H9a3 3 0 0 0 0 6h6a3 3 0 0 1 0 6H6"/>',
flag:'<path d="M4 22V4M4 4h13l-2 4 2 4H4"/>',
sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
refresh:'<path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"/>',
chev:'<path d="M9 18l6-6-6-6"/>',
shield:'<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
calc:'<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 19h.01M12 19h.01M16 19h.01"/>',
activity:'<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
gear:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
logo:'<path d="M3 17l6-6 4 4 8-8"/>'
};
function ic(n,s,c){return '<svg width="'+(s||22)+'" height="'+(s||22)+'" viewBox="0 0 24 24" fill="none" stroke="'+(c||'currentColor')+'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+IC[n]+'</svg>'}
function tint(c){return 'background:'+c+'26;color:'+c}
var COL={acc:'#7C6CFF',blue:'#38BDF8',ok:'#22D3A0',bad:'#FF6B81',warn:'#FBBF24',pink:'#F472B6'};
var store={get:function(k){try{return localStorage.getItem(k)}catch(e){return null}},set:function(k,v){try{localStorage.setItem(k,v)}catch(e){}}};
function fmt(n,d){n=Number(n);if(!isFinite(n))return '-';return Number(n).toLocaleString('id-ID',{maximumFractionDigits:d==null?0:d,minimumFractionDigits:d==null?0:d})}
function rp(n){return (n<0?'-':'')+'Rp'+fmt(Math.abs(n))}
function today(){var d=new Date();return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2)}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function toast(t){var e=$('toast');e.textContent=t;e.style.display='block';setTimeout(function(){e.style.display='none'},2400)}

/* ======== 01. TEMA, UKURAN FONT, TINGGI LAYAR ======== */
function applyPrefs(){
  document.documentElement.setAttribute('data-t',store.get('theme')||'dark');
  document.documentElement.style.setProperty('--fs',(store.get('fs')||'16')+'px');
  var tc=(store.get('theme')==='light')?'#F1F4FC':'#0B1020';document.querySelector('meta[name=theme-color]').content=tc;
}
function fit(){document.documentElement.style.setProperty('--vh',window.innerHeight+'px')}
window.addEventListener('resize',fit);fit();applyPrefs();

/* ======== 02. PWA: MANIFEST INLINE ======== */
(function(){
  try{
    var svg='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" rx="110" fill="#7C6CFF"/><path d="M110 340l110-110 70 70 110-130" fill="none" stroke="#fff" stroke-width="44" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    var url='data:image/svg+xml;base64,'+btoa(svg);
    var m={name:'Trading Tracker',short_name:'Tracker',display:'standalone',background_color:'#0B1020',theme_color:'#0B1020',start_url:location.href,icons:[{src:url,sizes:'512x512',type:'image/svg+xml',purpose:'any'}]};
    var l=document.createElement('link');l.rel='manifest';l.href='data:application/manifest+json,'+encodeURIComponent(JSON.stringify(m));document.head.appendChild(l);
    var a=document.createElement('link');a.rel='apple-touch-icon';a.href=url;document.head.appendChild(a);
  }catch(e){}
})();
var deferredInstall=null;
window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();deferredInstall=e});

/* ======== 03. STATE ======== */
var APP_VER='12';
var cfg={settings:{},recent:[],dash:[],profile:{},params:[]},M={},HIS=[],DATA=[],page='dash';
var TYPES={TOPUP:['Top-up','wallet',COL.blue],BONUS:['Bonus','gift',COL.warn],WITHDRAW:['Withdraw','up',COL.ok],TRADE:['Trade','trend',COL.acc]};
function mv(k){return M[k]&&typeof M[k].value==='number'?M[k].value:0}
function F(r){var x=r.value;if(x===''||x==null)return '-';if(typeof x!=='number')return String(x);
  if(r.fmt==='rp')return rp(x);if(r.fmt==='usdt')return fmt(x,4)+' USDT';if(r.fmt==='pct')return fmt(x*100,2)+'%';if(r.fmt==='int')return fmt(x);return String(x)}
function sg(n){return n<0?'neg':n>0?'pos':''}

/* ======== 04. FOTO PROFIL DRIVE ======== */
function photoUrl(u){if(!u)return '';var m=u.match(/\/d\/([\w-]+)/)||u.match(/[?&]id=([\w-]+)/);return m?'https://drive.google.com/thumbnail?id='+m[1]+'&sz=w256':u}
function avatar(){
  var p=cfg.profile||{},n=p.PROFIL_NAMA||'User',u=photoUrl(p.PROFIL_FOTO_URL);
  var h=u?'<img src="'+esc(u)+'" referrerpolicy="no-referrer" onerror="this.parentNode.textContent=\''+esc(n.charAt(0).toUpperCase())+'\'">':esc(n.charAt(0).toUpperCase());
  $('avBtn').className='av';$('avBtn').innerHTML=h;
  var hr=new Date().getHours();$('hi').textContent=hr<11?'Selamat pagi':hr<15?'Selamat siang':hr<18?'Selamat sore':'Selamat malam';
  $('hn').textContent=n;
}

/* ======== 05. NAV ======== */
var NAV=[['dash','home','Dashboard'],['sum','chart','Ringkasan'],['his','list','History']];
