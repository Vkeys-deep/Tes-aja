  var chart=lineChart('mc1',lab,[{name:'Riwayat',color:COL.blue,data:hist.map(function(x){return x.v}).concat(new Array(m).fill(null))},
    {name:'Median',color:'tx',dash:'6 4',data:pad(bands.p50.slice(1),B0)},{name:'Optimis (p90)',color:'#8D9ABF',dash:'3 4',w:1.4,data:pad(bands.p90.slice(1),B0)},{name:'Pesimis (p10)',color:'#8D9ABF',dash:'3 4',w:1.4,data:pad(bands.p10.slice(1),B0)}],{fmt:fU});
  MCL={f:f,bands:bands,fin:{med:med,lo:lo,hi:hi,prob:prob,dd:r.ddMed},b0:B0};
  o.innerHTML=sc('Hasil simulasi ('+f.D+' hari)','activity',COL.acc,chart+'<div class="cap">Garis biru = riwayat, putus-putus putih = median, putus-putus abu = rentang 80% (p10 sampai p90).</div>'+
    mini([['Median akhir',fmt(med,2)+' USDT',rpOf(med)],['Rentang 80%',fmt(lo,2)+' - '+fmt(hi,2),'USDT'],['Peluang di atas modal bersih',fmt(prob*100,0)+'%','modal bersih '+fmt(contrib,2)+' USDT'],['Penurunan maks. tipikal',fmt(r.ddMed*100,0)+'%','dari puncak']])+
    '<div class="cap" style="margin-top:8px">600 jalur simulasi dari '+pool.length+' trade riwayat. Ini perkiraan statistik, bukan jaminan hasil.</div>'+
    '<button class="btn m" id="mcSaveBtn">Simpan sebagai rencana aktif</button>');
  attach('mc1');$('mcSaveBtn').onclick=mcSave}
function mcSave(){
  if(!MCL)return;var f=MCL.f,pl={t0:today(),b0:MCL.b0,D:f.D,tpd:f.tpd,kurs:f.kurs,top:f.top,wd:f.wd,bands:MCL.bands,fin:MCL.fin};
  fiturSave({plan:pl},function(){toast('Rencana disimpan sampai '+addDays(pl.t0,pl.D));openFt('mc');if(page==='dash')renderDash()})}
/* kartu rencana aktif di Dashboard: saldo aktual vs jalur proyeksi, selama masa berlaku */
function saldoOn(date,b0){var s=b0;DATA.forEach(function(r){if(r.tgl<=date&&typeof r.saldo==='number')s=r.saldo});return s}
function planCard(){
  var a=planAktif();if(!a)return '';var p=a.p,bd=p.bands,i,lab=[],ak=[],j=0;
  for(i=0;i<bd.d.length;i++){lab.push('H'+bd.d[i]);ak.push(bd.d[i]<=a.hari?saldoOn(addDays(p.t0,bd.d[i]),p.b0):null)}
  for(i=0;i<bd.d.length-1&&bd.d[i+1]<=a.hari;i++)j=i+1;
  var now=saldoOn(today(),p.b0),span=(bd.d[Math.min(j+1,bd.d.length-1)]-bd.d[j])||1,t=Math.min(1,Math.max(0,(a.hari-bd.d[j])/span)),nx=Math.min(j+1,bd.d.length-1),
      med=bd.p50[j]+(bd.p50[nx]-bd.p50[j])*t,diff=med?(now-med)/med*100:0;
  return sc('Rencana proyeksi aktif (hari '+a.hari+' dari '+p.D+')','activity',COL.acc,
    lineChart('pc1',lab,[{name:'Aktual',color:COL.blue,data:ak},{name:'Median',color:'tx',dash:'6 4',data:bd.p50},{name:'p90',color:'#8D9ABF',dash:'3 4',w:1.4,data:bd.p90},{name:'p10',color:'#8D9ABF',dash:'3 4',w:1.4,data:bd.p10}],{fmt:fU})+
    r2('Saldo aktual',fmt(now,2)+' USDT')+r2('Median proyeksi hari ini',fmt(med,2)+' USDT')+r2('Selisih vs median',(diff>=0?'+':'')+fmt(diff,1)+'%',sg(diff))+
    '<div class="cap">Berlaku sampai '+addDays(p.t0,p.D)+'. Ketuk ikon Proyeksi untuk mengubah atau menghapus.</div>')}

load();
</script>
